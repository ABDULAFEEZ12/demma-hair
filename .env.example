# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB connection string (database name "dimmahairshop" is set in app.py)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority

# Secret used to sign admin JWT session tokens and Flask sessions - use a long random string
JWT_SECRET=change-me-to-a-long-random-string

# imgbb.com API key, used to host uploaded product images
IMGBB_API_KEY=

# SquadCo secret key, used for card/bank transfer/USSD checkout
SQUADCO_SECRET_KEY=

# Public site URL, used to build the SquadCo payment callback
SITE_URL=https://dimmahairshop.com

# Optional: outgoing email for new-order notifications
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
ORDER_NOTIFY_EMAIL=

# Optional: used only by create_admin.py / reset_admin.py to seed the first admin account
ADMIN_SEED_EMAIL=admin@dimmahairshop.com
ADMIN_SEED_PASSWORD=change-this-password
